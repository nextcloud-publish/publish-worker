# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Needed to compile the container in kernel tests. The directories are never created.
BUILDS_DIR=/tmp/publish-worker-test-unused/builds
PAGES_DIR=/tmp/publish-worker-test-unused/pages
PUBLISH_BASE_URL=http://sites.test

# The host Postgres publish's tests use, with the same user. Doctrine appends _worker_test
# (config/packages/doctrine.yaml), so the tests run in publish_worker_test.
DATABASE_URL="postgresql://publish:secret@127.0.0.1:5432/publish?serverVersion=18&charset=utf8"
